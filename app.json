{
  "expo": {
    "name": "ANSOFTT DC",
    "slug": "dgmobile",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/ansoftt_logo_padded.png",
    "userInterfaceStyle": "automatic",
    "scheme": "dgmobile",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digcard.dgmobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow DigCard to use your microphone to record voice notes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ansoftt_logo_padded.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.ansoftt.dc",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DigCard to access your camera to scan QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DigCard to access your photos."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow DigCard to access your microphone to record notes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}